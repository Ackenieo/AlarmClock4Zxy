<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:contentDescription="@string/language_button"
            android:src="@drawable/ic_language"
            android:tint="?attr/accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/language_dialog_title"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/language_dialog_sub"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/language_system"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/language_system_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/language_system"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/language_system_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/language_selected"
            android:src="@drawable/ic_check"
            android:tint="?attr/accent"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/language_chinese"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/language_chinese_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/language_chinese"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/language_chinese_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/language_selected"
            android:src="@drawable/ic_check"
            android:tint="?attr/accent"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/language_english"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/language_english_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/language_english"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/language_english_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/language_selected"
            android:src="@drawable/ic_check"
            android:tint="?attr/accent"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/language_japanese"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/language_japanese_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/language_japanese"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/language_japanese_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/language_selected"
            android:src="@drawable/ic_check"
            android:tint="?attr/accent"
            android:visibility="invisible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/language_french"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_option"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="14dp">

        <TextView
            android:id="@+id/language_french_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/language_french"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/language_french_check"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/language_selected"
            android:src="@drawable/ic_check"
            android:tint="?attr/accent"
            android:visibility="invisible" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginTop="12dp"
        android:text="@string/language_note"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/language_cancel"
        style="@style/Widget.GhostButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:text="@string/cancel" />
</LinearLayout>
