<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/bgColor">

    <!-- 特效背景：流光。画在所有内容底下，不接管触摸 -->
    <com.example.alarmclock4jacw.FlowLightView
        android:id="@+id/flow_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- 大标题 + 右上角圆形加号 -->
        <LinearLayout
            android:id="@+id/header_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="36dp"
            android:paddingEnd="24dp">

            <!-- 特效文本：像素风标题（自定义 View，把字画小再放大） -->
            <com.example.alarmclock4jacw.PixelTextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackground"
                android:letterSpacing="-0.02"
                android:text="@string/home_title"
                android:textColor="@color/text_primary"
                android:textSize="40sp"
                android:textStyle="bold" />

            <!-- 皮肤市场入口：T 恤图标 -->
            <ImageButton
                android:id="@+id/fab_skin"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/skin_market"
                android:scaleType="center"
                android:src="@drawable/ic_shirt"
                android:tint="?attr/accent" />

            <ImageButton
                android:id="@+id/fab_add"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_circle_button"
                android:contentDescription="@string/add_alarm"
                android:scaleType="center"
                android:src="@drawable/ic_add"
                android:tint="@color/text_primary" />
        </LinearLayout>

        <TextView
            android:id="@+id/subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="26dp"
            android:layout_marginTop="8dp"
            android:text="@string/next_alarm_none"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />

        <ScrollView
            android:id="@+id/alarm_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="18dp"
            android:paddingBottom="40dp">

            <LinearLayout
                android:id="@+id/alarm_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <!-- 特效 UI：扫描线。压在内容上面（文字会有一点屏幕感），但不接管触摸 -->
    <com.example.alarmclock4jacw.ScanlineView
        android:id="@+id/scanline"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 特效 UI：点击粒子。最上面一层，同样不接管触摸，只由 Activity 喂坐标 -->
    <com.example.alarmclock4jacw.ParticleLayer
        android:id="@+id/particles"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</FrameLayout>
