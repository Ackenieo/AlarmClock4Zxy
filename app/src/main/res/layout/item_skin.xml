<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_columnWeight="1"
    android:layout_margin="5dp"
    android:background="@drawable/bg_card_glass"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- 特效预览：底色 + 会动的流光 + 两个色点。clipToOutline 让流光也被裁成圆角 -->
    <FrameLayout
        android:id="@+id/skin_preview"
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:clipToOutline="true">

        <com.example.alarmclock4jacw.FlowLightView
            android:id="@+id/skin_flow"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/skin_dot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center" />

        <View
            android:id="@+id/skin_dot_small"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_gravity="center_vertical|end"
            android:layout_marginEnd="14dp" />

        <TextView
            android:id="@+id/skin_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="8dp"
            android:background="@drawable/bg_fx_badge"
            android:letterSpacing="0.08"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="@string/fx_badge"
            android:textColor="@color/text_primary"
            android:textSize="9sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/skin_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/skin_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/text_tertiary"
        android:textSize="11sp" />
</LinearLayout>
